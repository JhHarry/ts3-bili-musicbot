[Unit]
Description=Bilibili audio proxy for TS3AudioBot
After=network.target

[Service]
# 运行模式：stream（默认，边播边释放，不落盘）| cache（边下边播并落盘）
# 切换示例：sudo systemctl edit bili-proxy  →  [Service]\nEnvironment=BILI_PROXY_MODE=cache
#Environment=BILI_PROXY_MODE=cache
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=/opt/ts3bot
Environment=TMPDIR=/var/tmp/ytdlp
ExecStart=/usr/bin/python3 /opt/ts3bot/bili_proxy.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
