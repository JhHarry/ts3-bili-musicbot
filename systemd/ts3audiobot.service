[Unit]
Description=TS3AudioBot (TeamSpeak 3 music bot)
After=network.target teamspeak3.service
Wants=teamspeak3.service

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=/opt/ts3bot
Environment=LD_LIBRARY_PATH=/opt/ts3bot/private-libs/usr/lib/x86_64-linux-gnu
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
ExecStart=/opt/ts3bot/TS3AudioBot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
